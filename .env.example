# LLM: any OpenAI-compatible endpoint. Leave the key empty to run fully offline.
EARSHOT_LLM_API_KEY=
EARSHOT_LLM_BASE_URL=https://api.groq.com/openai/v1
EARSHOT_LLM_MODEL=llama-3.3-70b-versatile
# USD per million tokens. Copy these from your provider's current pricing page.
EARSHOT_LLM_PRICE_INPUT_PER_M=0
EARSHOT_LLM_PRICE_OUTPUT_PER_M=0

# hashing (no download) | minilm (needs requirements-ml.txt)
EARSHOT_EMBEDDER=hashing
# none | lexical | cross-encoder (needs requirements-ml.txt)
EARSHOT_RERANKER=lexical
EARSHOT_WHISPER_MODEL=tiny.en

# Set this on any public deployment to protect the note-writing endpoints.
EARSHOT_API_TOKEN=
